# API esistente usata per aggiornare il calendario pubblico.
SAGRE_API_BASE_URL=

# MySQL — copiare questi nomi in .env.local e nelle Environment Variables Vercel.
# Non inserire credenziali reali in questo file.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Connessione cifrata consigliata per database remoti.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Facoltativo: certificato CA PEM, anche multilinea tra virgolette.
DB_SSL_CA=

# Ogni istanza serverless mantiene al massimo questo numero di connessioni.
DB_CONNECTION_LIMIT=3

# Protezione della futura pagina amministrativa.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Analisi automatica delle locandine.
GEMINI_API_KEY=

# MinIO — il bucket deve esistere ed essere leggibile pubblicamente.
MINIO_ENDPOINT=https://minio.sagramanije.it
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=locandine
# Base pubblica che contiene direttamente gli oggetti del bucket.
# Con accesso path-style standard: https://minio.sagramanije.it/locandine
MINIO_PUBLIC_URL=https://minio.sagramanije.it/locandine

# Opzione alternativa selezionabile dal form amministrativo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
