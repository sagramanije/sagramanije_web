# API esistente usata per aggiornare il calendario pubblico.
SAGRE_API_BASE_URL=

# MySQL — copiare questi nomi in .env.local e nelle Environment Variables Vercel.
# Non inserire credenziali reali in questo file.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Connessione cifrata consigliata per database remoti.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Facoltativo: certificato CA PEM, anche multilinea tra virgolette.
DB_SSL_CA=

# Ogni istanza serverless mantiene al massimo questo numero di connessioni.
DB_CONNECTION_LIMIT=3

# Protezione della futura pagina amministrativa.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
